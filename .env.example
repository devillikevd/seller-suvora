# Environment variables for SUVORA Seller Hub Backend
# Supports PostgreSQL (Neon, Supabase, Railway, AWS RDS or Local PostgreSQL)

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/suvora_seller?schema=public"

# JWT Secret for Seller Authentication Sessions
JWT_SECRET="suvora-seller-super-secure-jwt-secret-key-2026-hyperlocal"

# Node Environment
NODE_ENV="development"

